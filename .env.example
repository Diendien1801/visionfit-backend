# Template for .env, which docker-compose.yml reads.
# Copy this file to .env and replace every change_me with a real password.
# .env holds secrets and is git-ignored; this example file is committed.

# Identity Service database
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_svc
IDENTITY_DB_PASSWORD=change_me
IDENTITY_DB_PORT=5433

# Identity Service (Spring Boot app on host)
IDENTITY_SERVICE_PORT=8081
# Shared by every service: identity-service signs tokens with it, the others verify them.
JWT_SECRET=change_me_use_at_least_32_characters
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Profile Service database
PROFILE_DB_NAME=profile_db
PROFILE_DB_USER=profile_svc
PROFILE_DB_PASSWORD=change_me
PROFILE_DB_PORT=5434

# Profile Service (Spring Boot app on host)
PROFILE_SERVICE_PORT=8082

# Meal Service database
MEAL_DB_NAME=meal_db
MEAL_DB_USER=meal_svc
MEAL_DB_PASSWORD=change_me
MEAL_DB_PORT=5435

# Meal Service (Spring Boot app on host)
MEAL_SERVICE_PORT=8083

# Analysis Service database
ANALYSIS_DB_NAME=analysis_db
ANALYSIS_DB_USER=analysis_svc
ANALYSIS_DB_PASSWORD=change_me
ANALYSIS_DB_PORT=5436

# Analysis Service (Spring Boot app on host)
ANALYSIS_SERVICE_PORT=8084
# Claude API key for the vision model (https://console.anthropic.com). Without it every analysis fails.
ANTHROPIC_API_KEY=

# API Gateway (Spring Boot app on host): the only port the app calls; it forwards to the services above.
GATEWAY_PORT=8080

# ---- Production only (docker-compose.prod.yml) ----
# Superuser of the single Postgres container; the four services never use it.
POSTGRES_PASSWORD=change_me
# Cloudflare Zero Trust > Networks > Tunnels > <tunnel> > Install connector: the long token after "--token".
CLOUDFLARE_TUNNEL_TOKEN=
