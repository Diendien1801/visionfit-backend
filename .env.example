# Template for .env, which docker-compose.yml reads.
# Copy this file to .env and replace every change_me with a real password.
# .env holds secrets and is git-ignored; this example file is committed.

# Identity Service database
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_svc
IDENTITY_DB_PASSWORD=change_me
IDENTITY_DB_PORT=5433

# Identity Service (Spring Boot app on host)
IDENTITY_SERVICE_PORT=8081
JWT_SECRET=change_me_use_at_least_32_characters
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
